{
  // JSONC benchdata — mirrors benchdata.json but with comments to exercise
  // the JSONC parser used by the embedded config and i18n loaders.
  "meta": {
    /* metadata block */
    "name": "benchmark",
    "version": 1,
    "description": "JSONC dataset for serialization benchmarks"
  },
  // panel labels
  "panel": {
    "containers": "Containers",
    "images": "Images",
    "volumes": "Volumes",
    "networks": "Networks",
    "compose": "Compose",
    "logs": "Logs",
    "detail": "Detail",
    "help": "Help",
    "settings": "Settings",
    "dashboard": "Dashboard"
  },
  /* key descriptions */
  "key": {
    "start": "Start",
    "stop": "Stop",
    "restart": "Restart",
    "kill": "Kill",
    "detail": "Detail",
    "delete": "Delete",
    "debug": "Debug",
    "export": "Export",
    "logs": "Logs",
    "stats": "Stats",
    "exec": "Exec",
    "expand": "Containers",
    "collapse": "Collapse",
    "filter": "Filter",
    "help": "Help",
    "quit": "Quit",
    "connect": "Connect",
    "toggle": "Toggle",
    "back": "Back",
    "scroll": "Scroll",
    "page": "Page",
    "top": "Top",
    "bottom": "Bottom",
    "confirm": "Confirm",
    "cancel": "Cancel",
    "mark": "Mark",
    "pull": "Pull",
    "prune": "Prune",
    "sort": "Sort"
  },
  // toast messages
  "toast": {
    "started": "Started {0}",
    "stopped": "Stopped {0}",
    "restarted": "Restarted {0}",
    "killed": "Killed {0}",
    "deleted": "Deleted {0}",
    "pulled": "Pulled {0}",
    "pruned": "Pruned {0}",
    "exported": "Exported {0}",
    "failed": "Failed {0}"
  },
  // dialog labels
  "dialog": {
    "delete_title": "Delete {0}",
    "confirm_delete": "Delete {0}?",
    "force": "Force remove",
    "remove_volumes": "Remove volumes",
    "remove_links": "Remove links",
    "target": "Target: {0}"
  },
  /* status indicators */
  "status": {
    "connected": "● connected",
    "disconnected": "○ disconnected",
    "running": "● {0} running",
    "error": "Error: {0}",
    "loading": "Loading..."
  },
  // table headers
  "table": {
    "id": "ID",
    "name": "NAME",
    "image": "IMAGE",
    "state": "STATE",
    "created": "CREATED",
    "ip": "IP",
    "ports": "PORTS",
    "mounts": "MOUNTS",
    "cpu": "CPU",
    "mem": "MEM",
    "registry": "REGISTRY",
    "tag": "TAG",
    "arch": "ARCH",
    "size": "SIZE",
    "project": "PROJECT",
    "services": "SERVICES",
    "containers": "CONTAINERS"
  },
  // help sections
  "help": {
    "navigation": "Navigation",
    "containers_section": "Containers",
    "images_section": "Images",
    "volumes_section": "Volumes & Networks",
    "global": "Global",
    "cli_flags": "CLI Flags",
    "themes": "Themes"
  },
  /* misc messages */
  "msg": {
    "loading": "Loading...",
    "no_containers": "No containers found",
    "no_images": "No images found",
    "no_volumes": "No volumes found",
    "no_networks": "No networks found",
