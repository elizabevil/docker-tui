        "header": "table.status"
      },
      {
        "key": "services",
        "fixed": 8,
        "header": "table.services"
      },
      {
        "key": "pods",
        "fixed": 8,
        "header": "table.containers"
      }
    ],
    "services_sub": [
      {
        "key": "service",
        "flex": 1,
        "max": 24,
        "header": "table.service"
      },
      {
        "key": "image",
        "flex": 2,
        "max": 30,
        "header": "table.image"
      },
      {
        "key": "pods",
        "fixed": 8,
        "header": "table.pods"
      }
    ],
    "pods_sub": [
      {
        "key": "id",
