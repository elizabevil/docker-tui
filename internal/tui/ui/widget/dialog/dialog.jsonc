{
  // Dialog width as percentage of terminal width (50 = 50%).
  "widthPercent": 50,
  // Dialog height as percentage of terminal height (50 = 50%).
  "heightPercent": 50,
  // Minimum width in columns.
  "minWidth": 40,
  // Maximum width in columns.
  "maxWidth": 160,
  // Minimum height in rows.
  "minHeight": 15,
  // Maximum height in rows.
  "maxHeight": 80,
  // Horizontal position offset as percentage of terminal width (50 = center).
  "xOffset": 50,
  // Vertical position offset as percentage of terminal height (50 = center).
  "yOffset": 50,
  // Overlay/scrim base hex color (without alpha).
  "overlayColor": "#0d1117",
  // Overlay opacity (0-100). Combined with overlayColor to produce alpha.
  "overlayOpacity": 50,
  // Dialog confirmation key binding.
  "confirmKey": "Enter",
  // Dialog cancel key binding.
  "cancelKey": "Esc"
}
