{
  // Single source for shared table layout and visual styling.
  "table": {
    "columnSpacing": 2,
    "rowPrefix": "  ",
    "rowPrefixSelected": "\u2503 ",
    "rowSpacing": 0,
    "selectionInfo": {
      "enabled": true,
      "padLines": 1,
      "color": "#A5D6A7",
      "background": ""
    }
  },
  "rowStyles": {
    "selected": {
      "color": "blue",
      "background": "#000000",
      "bold": true
    },
    "normal": {
      "color": "orange"
    },
    "alt": {
      "faint": true,
      "background": "#1e1f22"
    },
    "marked": {
      "color": "white",
      "background": "#463f16",
      "bold": true
    }
  },
  "stateStyles": {
    "running": { "color": "green" },
    "stopping": { "color": "yellow" },
    "stopped": { "color": "white", "faint": true },
    "exited": { "color": "white", "faint": true },
    "paused": { "color": "yellow" },
    "created": { "color": "blue" },
    "restarting": { "color": "orange" },
    "dead": { "color": "red" }
  },
  // Column appearance is semantic and shared by every resource profile.
  "columnStyles": {
    "id": { "color": "#ECEFF1", "faint": true },
    "name": { "color": "#ECEFF1", "bold": true },
    "project": { "color": "#ECEFF1", "bold": true },
    "service": { "color": "#ECEFF1", "bold": true },
    "registry": { "color": "#ECEFF1", "faint": true },
    "tag": { "color": "#ECEFF1" },
    "platform": { "color": "#ECEFF1", "faint": true },
    "state": { "color": "#ECEFF1" },
    "status": { "color": "#ECEFF1" },
    "created": { "color": "#ECEFF1", "faint": true },
    "time": { "color": "#ECEFF1", "faint": true },
    "ports": { "color": "#ECEFF1" },
    "subnet": { "color": "#ECEFF1" }
  }
}
