{
  // 通用组件样式 — 仅保留非表格组件的样式引用。
  // 表格专有样式（rowSelected / stateRunning 等）移至 table.jsonc。
  "styles": {
    // SearchFilter 搜索过滤
    "searchBar": {
      "color": "white"
    },
    "searchCursor": {
      "color": "white",
      "bold": true
    },
    "searchHint": {
      "color": "gray",
      "faint": true
    },
    "commandPrefix": {
      "color": "green"
    },
    // Breadcrumb 面包屑导航
    "breadcrumb": {
      "color": "gray",
      "faint": true
    },
    "breadcrumbActive": {
      "color": "cyan"
    },
    // Toast 通知
    "toastSuccess": {
      "color": "green"
    },
    "toastError": {
      "color": "red"
    },
    "toastInfo": {
      "color": "blue"
    },
    "toastWarning": {
      "color": "#d1b105"
    },
    // KeyHint 快捷键提示
    "hintKey": {
      "color": "white",
      "bold": true
    },
    "hintDesc": {
      "color": "gray"
    },
    "hintSep": {
      "color": "gray"
    },
    // Dialog 对话框
    "dialogTitle": {
      "color": "red",
      "bold": true
    },
    "dialogBody": {
      "color": "white"
    },
    "dialogOption": {
      "color": "cyan"
    },
    "dialogOptionDisabled": {
      "color": "gray"
    },
    // 其他通用
    "panelTitle": {
      "color": "cyan",
      "bold": true
    },
    "dim": {
      "color": "gray",
      "faint": true
    },
    "helpKey": {
      "color": "cyan"
    },
    "helpDesc": {
      "color": "white"
    },
    // Detail page — 柔和护眼配色 (全 faint 降低对比度)
    "detailSection": {
      "color": "white",
      "faint": true
    },
    "detailLabel": {
      "color": "cyan",
      "faint": true
    },
    "detailValue": {
      "color": "white",
      "faint": true
    },
    "detailDim": {
      "color": "gray",
      "faint": true
    },
    // Log viewer — 柔和护眼配色
    "logTimestamp": {
      "color": "cyan",
      "faint": true
    },
    "logText": {
      "color": "white",
      "faint": true
    },
    "logStderr": {
      "color": "red",
      "faint": true
    },
    "logHighlightBg": {
      "color": "dark",
      "background": "yellow"
    }
  }
}
