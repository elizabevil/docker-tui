{
  // Private styles for SearchFilter component.
  // Registered via RegisterComponentStyles("filter", ...) during init().
  "styles": {
    "searchPrompt": {
      "color": "cyan"
    },
    "searchCursor": {
      "color": "white",
      "bold": true
    },
    "searchHint": {
      "color": "gray",
      "faint": true
    },
    "commandPrefix": {
      "color": "green"
    }
  }
}