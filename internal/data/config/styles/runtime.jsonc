{
  // BR-043 §3.4 — runtime section (includes connection examples as comments)
  "runtime": {
    "default": "local-docker",
    "discovery": {
      "localDocker": true,
      "localPodman": true
    },
    "health": {
      "intervalSec": 3,
      "timeoutSec": 2,
      "failureThreshold": 2
    },
    "connections": [
      // Example remote connection (override or uncomment to enable):
      // {
      //   "name": "remote-docker",
      //   "driver": "docker",
      //   "endpoint": "tcp://docker.example.com:2376",
      //   "apiVersion": "",
      //   "tls": {
      //     "enabled": true,
      //     "verify": true,
      //     "insecureSkipVerify": false,
      //     "caFile": "/etc/docker/certs/ca.pem",
      //     "certFile": "/etc/docker/certs/cert.pem",
      //     "keyFile": "/etc/docker/certs/key.pem",
      //     "serverName": "docker.example.com"
      //   }
      // }
    ]
  }
}