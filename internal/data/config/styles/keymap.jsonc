{
  // BR-043 §3.4 — keymap section (all key bindings)
  "keymap": {
    "quit": ["ctrl+c"],
    "actionBar": [";"],
    "help": ["?", "f1"],
    "filter": ["/"],
    "refresh": ["r"],
    "containerStart": ["s"],
    "containerStop": ["ctrl+s"],
    "containerRestart": ["ctrl+r"],
    "containerKill": ["ctrl+k"],
    "containerRemove": ["ctrl+d"],
    "containerLogs": ["l"],
    "containerExec": ["e"],
    "containerInspect": ["i"],
    "containerStats": ["m"],
    "containerPause": ["p"],
    "imagePull": ["ctrl+p"],
    "imageRemove": ["ctrl+d"],
    "imagePrune": ["p"],
    "imageTag": ["ctrl+t"],
    "imagePush": ["ctrl+u"],
    "imageSave": ["ctrl+e"],
    "imageLoad": ["ctrl+l"],
    "imageHistory": ["h"],
    "volumeCreate": ["c"],
    "volumePrune": ["p"],
    "volumeRemove": ["ctrl+d"],
    "networkCreate": ["c"],
    "networkPrune": ["p"],
    "networkRemove": ["ctrl+d"],
    "tabNext": ["tab"],
    "tabPrev": ["shift+tab"],
    "up": ["up", "k"],
    "down": ["down", "j"],
    "enter": ["enter"],
    "back": ["esc"],
    "delete": ["ctrl+d"]
  }
}