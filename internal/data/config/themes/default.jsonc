{
  "meta": {
    "name": "Default Dark",
    "description": "JetBrains Rider inspired dark theme"
  },
  "theme": {
    "palette": {
      "primary": "#56b4c2",
      "success": "#499c54",
      "warning": "#c8a35e",
      "danger": "#db5a5a",
      "info": "#589df6",
      "accent": "#cc7832",
      "accentSecondary": "#a962b5",
      "foreground": "#c9d1d9",
      "foregroundMuted": "#5a6270",
      "background": "#18191b",
      "backgroundSubtle": "#1e1f22",
      "backgroundDeep": "#2b2d30"
    },
    "chrome": {
      "borderKind": "rounded",
      "panelBorderActive": "primary",
      "panelBorderInactive": "foregroundMuted",
      "panelBorderFocused": "success",
      "panelTitle": "primary",
      "panelFooter": "foregroundMuted",
      "panelRowSelected": "info",
      "panelRowText": "foreground",
      "panelTableHeader": "info",
      "dialogBorder": "danger",
      "dialogTitle": "danger",
      "dialogOptionActive": "primary",
      "dialogOptionInactive": "foregroundMuted",
      "dialogOverlay": "background",
      "dialogOverlayOpacity": 80,
      "headerLabel": "foregroundMuted",
      "headerValue": "foreground",
      "headerLogo": "info",
      "footerKey": "foreground",
      "footerDescription": "foregroundMuted",
      "footerSeparator": "foregroundMuted"
    },
    "surfaces": {
      "panel": "transparent",
      "actionBar": "transparent",
      "messageRail": "transparent",
      "queryBar": "transparent",
      "dialogBody": "background",
      "header": "transparent",
      "footer": "transparent",
      "toast": "transparent",
      "rowSelected": "info"
    },
    "text": {
      "info": "primary",
      "success": "success",
      "warning": "warning",
      "error": "danger",
      "dim": "foregroundMuted",
      "helpKey": "primary",
      "helpDescription": "foreground",
      "dialogBody": "foreground"
    },
    "feedback": {
      "toastSuccess": "success",
      "toastError": "danger",
      "toastInfo": "info",
      "toastWarning": "warning",
      "safeNormal": "foreground",
      "safeBold": "foreground",
      "safeDim": "foregroundMuted",
      "safeAccent": "primary",
      "safeError": "danger"
    },
    "data": {
      "markedBackground": "#463f16",
      "columnForeground": "#ECEFF1",
      "nameForeground": "#FAF0E6"
    },
    "action": {
      "container": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      },
      "image": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      },
      "volume": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      },
      "network": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      },
      "compose": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      }
    }
  }
}
