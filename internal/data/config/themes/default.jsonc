{
  "meta": {
    "name": "Default Dark",
    "description": "JetBrains Rider inspired dark theme"
  },
  "theme": {
    "palette": {
      "success": "#499c54",
      "primary": "#56b4c2",
      "info": "#589df6",
      "danger": "#db5a5a",
      "warning": "#c8a35e",
      "accent": "#cc7832",
      "accentSecondary": "#a962b5",
      "foreground": "#c9d1d9",
      "foregroundMuted": "#5a6270",
      "backgroundSubtle": "#1e1f22",
      "backgroundDeep": "#2b2d30",
      "background": "#18191b"
    },
    "border": {
      "active": {
        "token": "primary"
      },
      "inactive": {
        "token": "foregroundMuted"
      },
      "focused": {
        "token": "success"
      },
      "kind": "rounded"
    },
    "header": {
      "background": {
        "token": "transparent"
      },
      "label": {
        "token": "transparent"
      },
      "value": {
        "token": "transparent"
      },
      "logo": {
        "token": "info"
      }
    },
    "main": {
      "borderActive": {
        "token": "primary"
      },
      "borderInactive": {
        "token": "foregroundMuted"
      },
      "title": {
        "token": "primary"
      },
      "tableHeader": {
        "token": "info"
      },
      "rowSelected": {
        "value": "grey"
      },
      "rowText": {
        "token": "foreground"
      },
      "footer": {
        "token": "foregroundMuted"
      },
      "panelBackground": {
        "token": "transparent"
      },
      "actionBarBackground": {
        "token": "transparent"
      },
      "messageRailBackground": {
        "token": "transparent"
      },
      "queryBarBackground": {
        "token": "transparent"
      }
    },
    "footer": {
      "statusBackground": {
        "token": "transparent"
      },
      "shortcutBackground": {
        "token": "transparent"
      },
      "key": {
        "token": "foreground"
      },
      "description": {
        "token": "foregroundMuted"
      },
      "separator": {
        "token": "foregroundMuted"
      }
    },
    "dialog": {
      "border": {
        "token": "danger"
      },
      "title": {
        "token": "danger"
      },
      "body": {
        "token": "foreground"
      },
      "bodyBackground": {
        "value": "#18191b"
      },
      "optionActive": {
        "token": "primary"
      },
      "optionInactive": {
        "token": "foregroundMuted"
      },
      "overlay": {
        "token": "background"
      },
      "overlayOpacity": 80
    },
    "toast": {
      "success": {
        "token": "success"
      },
      "error": {
        "token": "danger"
      },
      "background": {
        "token": "background"
      }
    },
    "text": {
      "info": {
        "token": "primary"
      },
      "error": {
        "token": "danger"
      },
      "success": {
        "token": "success"
      },
      "warning": {
        "token": "warning"
      },
      "dim": {
        "token": "foregroundMuted"
      },
      "helpKey": {
        "token": "primary"
      },
      "helpDescription": {
        "token": "foreground"
      }
    },
    "table": {
      "markedBackground": {
        "value": "#463f16"
      },
      "columnForeground": {
        "value": "#ECEFF1"
      },
      "nameForeground": {
        "value": "#FAF0E6"
      }
    },
    "safeFallback": {
      "normal": {
        "token": "foreground"
      },
      "bold": {
        "token": "foreground"
      },
      "dim": {
        "token": "foregroundMuted"
      },
      "accent": {
        "token": "primary"
      },
      "error": {
        "token": "danger"
      }
    }
  }
}
