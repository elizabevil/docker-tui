{
  "meta": {
    "name": "Light",
    "description": "Rider-inspired light theme"
  },
  "theme": {
    "palette": {
      "success": "#3e8b3e",
      "primary": "#067dcd",
      "info": "#3875d7",
      "danger": "#c84a4a",
      "warning": "#a07a1a",
      "accent": "#b8631e",
      "accentSecondary": "#8a3fa0",
      "foreground": "#2b2b2b",
      "foregroundMuted": "#9b9b9b",
      "backgroundSubtle": "#e8e8e8",
      "backgroundDeep": "#f0f0f0",
      "background": "#fefefe"
    },
    "border": {
      "active": {
        "token": "primary"
      },
      "inactive": {
        "token": "foregroundMuted"
      },
      "focused": {
        "token": "success"
      },
      "kind": "rounded"
    },
    "header": {
      "background": {
        "token": "transparent"
      },
      "label": {
        "token": "foregroundMuted"
      },
      "value": {
        "token": "foreground"
      },
      "logo": {
        "token": "info"
      }
    },
    "main": {
      "borderActive": {
        "token": "primary"
      },
      "borderInactive": {
        "token": "foregroundMuted"
      },
      "title": {
        "token": "primary"
      },
      "tableHeader": {
        "token": "info"
      },
      "rowSelected": {
        "token": "info"
      },
      "rowText": {
        "token": "foreground"
      },
      "footer": {
        "token": "foregroundMuted"
      },
      "actionBarBackground": {
        "token": "transparent"
      },
      "messageRailBackground": {
        "token": "transparent"
      },
      "queryBarBackground": {
        "token": "transparent"
      }
    },
    "footer": {
      "statusBackground": {
        "token": "transparent"
      },
      "shortcutBackground": {
        "token": "transparent"
      },
      "key": {
        "token": "foreground"
      },
      "description": {
        "token": "foregroundMuted"
      },
      "separator": {
        "token": "foregroundMuted"
      }
    },
    "dialog": {
      "border": {
        "token": "danger"
      },
      "title": {
        "token": "danger"
      },
      "body": {
        "token": "foreground"
      },
      "optionActive": {
        "token": "primary"
      },
      "optionInactive": {
        "token": "foregroundMuted"
      },
      "overlay": {
        "token": "background"
      },
      "overlayOpacity": 80
    },
    "toast": {
      "success": {
        "token": "success"
      },
      "error": {
        "token": "danger"
      },
      "background": {
        "token": "background"
      }
    },
    "text": {
      "info": {
        "token": "primary"
      },
      "error": {
        "token": "danger"
      },
      "success": {
        "token": "success"
      },
      "warning": {
        "token": "warning"
      },
      "dim": {
        "token": "foregroundMuted"
      },
      "helpKey": {
        "token": "primary"
      },
      "helpDescription": {
        "token": "foreground"
      }
    },
    "table": {
      "markedBackground": {
        "value": "#463f16"
      },
      "columnForeground": {
        "value": "#1f2328"
      },
      "nameForeground": {
        "value": "#0d1117"
      }
    },
    "safeFallback": {
      "normal": {
        "token": "foreground"
      },
      "bold": {
        "token": "foreground"
      },
      "dim": {
        "token": "foregroundMuted"
      },
      "accent": {
        "token": "primary"
      },
      "error": {
        "token": "danger"
      }
    }
  }
}
