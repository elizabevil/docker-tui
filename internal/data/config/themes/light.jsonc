{
  "meta": {
    "name": "Light",
    "description": "Rider-inspired light theme"
  },
  "theme": {
    "palette": {
      "green": "#3e8b3e",
      "cyan": "#067dcd",
      "blue": "#3875d7",
      "red": "#c84a4a",
      "yellow": "#a07a1a",
      "orange": "#b8631e",
      "purple": "#8a3fa0",
      "white": "#2b2b2b",
      "gray": "#9b9b9b",
      "dark": "#e8e8e8",
      "surface": "#f0f0f0",
      "background": "#fefefe"
    },
    "border": {
      "active": { "token": "cyan" },
      "inactive": { "token": "gray" },
      "focused": { "token": "green" },
      "kind": "rounded"
    },
    "header": {
      "background": { "token": "dark" },
      "label": { "token": "gray" },
      "value": { "token": "white" },
      "logo": { "token": "blue" }
    },
    "main": {
      "borderActive": { "token": "cyan" },
      "borderInactive": { "token": "gray" },
      "title": { "token": "cyan" },
      "tableHeader": { "token": "blue" },
      "rowSelected": { "token": "blue" },
      "rowText": { "token": "white" },
      "footer": { "token": "gray" }
    },
    "footer": {
      "statusBackground": { "token": "surface" },
      "shortcutBackground": { "token": "dark" },
      "key": { "token": "white" },
      "description": { "token": "gray" },
      "separator": { "token": "gray" }
    },
    "dialog": {
      "border": { "token": "red" },
      "title": { "token": "red" },
      "body": { "token": "white" },
      "optionActive": { "token": "cyan" },
      "optionInactive": { "token": "gray" },
      "overlay": { "token": "background" },
      "overlayOpacity": 80
    },
    "toast": {
      "success": { "token": "green" },
      "error": { "token": "red" },
      "background": { "token": "dark" }
    },
    "text": {
      "info": { "token": "cyan" },
      "error": { "token": "red" },
      "success": { "token": "green" },
      "warning": { "token": "yellow" },
      "dim": { "token": "gray" },
      "helpKey": { "token": "cyan" },
      "helpDescription": { "token": "white" }
    }
  }
}
