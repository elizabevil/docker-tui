{
  "meta": {
    "name": "Dracula",
    "description": "Purple Rider-inspired theme"
  },
  "theme": {
    "palette": {
      "success": "#50fa7b",
      "primary": "#8be9fd",
      "info": "#6272a4",
      "danger": "#ff5555",
      "warning": "#f1fa8c",
      "accent": "#ffb86c",
      "accentSecondary": "#bd93f9",
      "foreground": "#f8f8f2",
      "foregroundMuted": "#44475a",
      "backgroundSubtle": "#1e1f29",
      "backgroundDeep": "#282a36",
      "background": "#21222c"
    },
    "border": {
      "active": { "token": "accentSecondary" },
      "inactive": { "token": "foregroundMuted" },
      "focused": { "token": "success" },
      "kind": "rounded"
    },
    "header": {
      "background": { "token": "transparent" },
      "label": { "token": "foregroundMuted" },
      "value": { "token": "foreground" },
      "logo": { "token": "accentSecondary" }
    },
    "main": {
      "borderActive": { "token": "accentSecondary" },
      "borderInactive": { "token": "foregroundMuted" },
      "title": { "token": "accentSecondary" },
      "tableHeader": { "token": "primary" },
      "rowSelected": { "token": "accentSecondary" },
      "rowText": { "token": "foreground" },
      "footer": { "token": "foregroundMuted" }
    },
    "footer": {
      "statusBackground": { "token": "transparent" },
      "shortcutBackground": { "token": "transparent" },
      "key": { "token": "foreground" },
      "description": { "token": "foregroundMuted" },
      "separator": { "token": "foregroundMuted" }
    },
    "dialog": {
      "border": { "token": "danger" },
      "title": { "token": "danger" },
      "body": { "token": "foreground" },
      "optionActive": { "token": "primary" },
      "optionInactive": { "token": "foregroundMuted" },
      "overlay": { "token": "background" },
      "overlayOpacity": 80
    },
    "toast": {
      "success": { "token": "success" },
      "error": { "token": "danger" },
      "background": { "token": "background" }
    },
    "text": {
      "info": { "token": "primary" },
      "error": { "token": "danger" },
      "success": { "token": "success" },
      "warning": { "token": "warning" },
      "dim": { "token": "foregroundMuted" },
      "helpKey": { "token": "primary" },
      "helpDescription": { "token": "foreground" }
    },
    "table": {
      "markedBackground": { "value": "#463f16" },
      "columnForeground": { "value": "#ECEFF1" },
      "nameForeground": { "value": "#FAF0E6" }
    },
    "safeFallback": {
      "normal": { "token": "foreground" },
      "bold": { "token": "foreground" },
      "dim": { "token": "foregroundMuted" },
      "accent": { "token": "primary" },
      "error": { "token": "danger" }
    }
  }
}
