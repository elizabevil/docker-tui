{
  "meta": {
    "name": "Dracula",
    "description": "Dracula inspired dark theme"
  },
  "theme": {
    "palette": {
      "primary": "#8be9fd",
      "success": "#50fa7b",
      "warning": "#f1fa8c",
      "danger": "#ff5555",
      "info": "#6272a4",
      "accent": "#ff79c6",
      "accentSecondary": "#ffb86c",
      "foreground": "#f8f8f2",
      "foregroundMuted": "#6272a4",
      "background": "#282a36",
      "backgroundSubtle": "#21222c",
      "backgroundDeep": "#44475a"
    },
    "chrome": {
      "borderKind": "rounded",
      "panelBorderActive": "primary",
      "panelBorderInactive": "foregroundMuted",
      "panelBorderFocused": "success",
      "panelTitle": "primary",
      "panelFooter": "foregroundMuted",
      "panelRowSelected": "info",
      "panelRowText": "foreground",
      "panelTableHeader": "info",
      "dialogBorder": "danger",
      "dialogTitle": "danger",
      "dialogOptionActive": "primary",
      "dialogOptionInactive": "foregroundMuted",
      "dialogOverlay": "background",
      "dialogOverlayOpacity": 80,
      "headerLabel": "foregroundMuted",
      "headerValue": "foreground",
      "headerLogo": "info",
      "footerKey": "foreground",
      "footerDescription": "foregroundMuted",
      "footerSeparator": "foregroundMuted"
    },
    "surfaces": {
      "panel": "backgroundSubtle",
      "actionBar": "transparent",
      "messageRail": "transparent",
      "queryBar": "transparent",
      "dialogBody": "background",
      "header": "transparent",
      "footer": "transparent",
      "toast": "transparent",
      "rowSelected": "info"
    },
    "text": {
      "info": "primary",
      "success": "success",
      "warning": "warning",
      "error": "danger",
      "dim": "foregroundMuted",
      "helpKey": "primary",
      "helpDescription": "foreground",
      "dialogBody": "foreground"
    },
    "feedback": {
      "toastSuccess": "success",
      "toastError": "danger",
      "toastInfo": "info",
      "toastWarning": "warning",
      "safeNormal": "foreground",
      "safeBold": "foreground",
      "safeDim": "foregroundMuted",
      "safeAccent": "primary",
      "safeError": "danger"
    },
    "data": {
      "markedBackground": "#44475a",
      "columnForeground": "#f8f8f2",
      "nameForeground": "#ff79c6"
    },
    "action": {
      "container": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      },
      "image": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      },
      "volume": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      },
      "network": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      }
    }
  }
}
