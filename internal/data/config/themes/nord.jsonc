{
  "meta": {
    "name": "Nord",
    "description": "Arctic blue Rider-inspired theme"
  },
  "theme": {
    "palette": {
      "success": "#a3be8c",
      "primary": "#81a1c1",
      "info": "#5e81ac",
      "danger": "#bf616a",
      "warning": "#ebcb8b",
      "accent": "#d08770",
      "accentSecondary": "#b48ead",
      "foreground": "#eceff4",
      "foregroundMuted": "#4c566a",
      "backgroundSubtle": "#2e3440",
      "backgroundDeep": "#3b4252",
      "background": "#242933"
    },
    "border": {
      "active": {
        "token": "primary"
      },
      "inactive": {
        "token": "foregroundMuted"
      },
      "focused": {
        "token": "success"
      },
      "kind": "rounded"
    },
    "header": {
      "background": {
        "token": "transparent"
      },
      "label": {
        "token": "foregroundMuted"
      },
      "value": {
        "token": "foreground"
      },
      "logo": {
        "token": "info"
      }
    },
    "main": {
      "borderActive": {
        "token": "primary"
      },
      "borderInactive": {
        "token": "foregroundMuted"
      },
      "title": {
        "token": "primary"
      },
      "tableHeader": {
        "token": "info"
      },
      "rowSelected": {
        "token": "info"
      },
      "rowText": {
        "token": "foreground"
      },
      "footer": {
        "token": "foregroundMuted"
      },
      "actionBarBackground": {
        "token": "transparent"
      },
      "messageRailBackground": {
        "token": "transparent"
      },
      "queryBarBackground": {
        "token": "transparent"
      }
    },
    "footer": {
      "statusBackground": {
        "token": "transparent"
      },
      "shortcutBackground": {
        "token": "transparent"
      },
      "key": {
        "token": "foreground"
      },
      "description": {
        "token": "foregroundMuted"
      },
      "separator": {
        "token": "foregroundMuted"
      }
    },
    "dialog": {
      "border": {
        "token": "danger"
      },
      "title": {
        "token": "danger"
      },
      "body": {
        "token": "foreground"
      },
      "optionActive": {
        "token": "primary"
      },
      "optionInactive": {
        "token": "foregroundMuted"
      },
      "overlay": {
        "token": "background"
      },
      "overlayOpacity": 80
    },
    "toast": {
      "success": {
        "token": "success"
      },
      "error": {
        "token": "danger"
      },
      "background": {
        "token": "background"
      }
    },
    "text": {
      "info": {
        "token": "primary"
      },
      "error": {
        "token": "danger"
      },
      "success": {
        "token": "success"
      },
      "warning": {
        "token": "warning"
      },
      "dim": {
        "token": "foregroundMuted"
      },
      "helpKey": {
        "token": "primary"
      },
      "helpDescription": {
        "token": "foreground"
      }
    },
    "table": {
      "markedBackground": {
        "value": "#463f16"
      },
      "columnForeground": {
        "value": "#ECEFF1"
      },
      "nameForeground": {
        "value": "#FAF0E6"
      }
    },
    "safeFallback": {
      "normal": {
        "token": "foreground"
      },
      "bold": {
        "token": "foreground"
      },
      "dim": {
        "token": "foregroundMuted"
      },
      "accent": {
        "token": "primary"
      },
      "error": {
        "token": "danger"
      }
    }
  }
}
