{
  "meta": {
    "name": "Nord",
    "description": "Arctic blue Rider-inspired theme"
  },
  "theme": {
    "palette": {
      "green": "#a3be8c",
      "cyan": "#81a1c1",
      "blue": "#5e81ac",
      "red": "#bf616a",
      "yellow": "#ebcb8b",
      "orange": "#d08770",
      "purple": "#b48ead",
      "white": "#eceff4",
      "gray": "#4c566a",
      "dark": "#2e3440",
      "surface": "#3b4252",
      "background": "#242933"
    },
    "border": {
      "active": { "token": "cyan" },
      "inactive": { "token": "gray" },
      "focused": { "token": "green" },
      "kind": "rounded"
    },
    "header": {
      "background": { "token": "dark" },
      "label": { "token": "gray" },
      "value": { "token": "white" },
      "logo": { "token": "blue" }
    },
    "main": {
      "borderActive": { "token": "cyan" },
      "borderInactive": { "token": "gray" },
      "title": { "token": "cyan" },
      "tableHeader": { "token": "blue" },
      "rowSelected": { "token": "blue" },
      "rowText": { "token": "white" },
      "footer": { "token": "gray" }
    },
    "footer": {
      "statusBackground": { "token": "surface" },
      "shortcutBackground": { "token": "dark" },
      "key": { "token": "white" },
      "description": { "token": "gray" },
      "separator": { "token": "gray" }
    },
    "dialog": {
      "border": { "token": "red" },
      "title": { "token": "red" },
      "body": { "token": "white" },
      "optionActive": { "token": "cyan" },
      "optionInactive": { "token": "gray" },
      "overlay": { "token": "background" },
      "overlayOpacity": 80
    },
    "toast": {
      "success": { "token": "green" },
      "error": { "token": "red" },
      "background": { "token": "dark" }
    },
    "text": {
      "info": { "token": "cyan" },
      "error": { "token": "red" },
      "success": { "token": "green" },
      "warning": { "token": "yellow" },
      "dim": { "token": "gray" },
      "helpKey": { "token": "cyan" },
      "helpDescription": { "token": "white" }
    }
  }
}
