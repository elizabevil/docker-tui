{
  "meta": {
    "name": "Nord",
    "description": "Nord inspired cool dark theme"
  },
  "theme": {
    "palette": {
      "primary": "#81a1c1",
      "success": "#a3be8c",
      "warning": "#ebcb8b",
      "danger":  "#bf616a",
      "info":    "#88c0d0",
      "accent":  "#b48ead",
      "accentSecondary": "#d08770",
      "foreground":      "#eceff4",
      "foregroundMuted": "#4c566a",
      "background":      "#242933",
      "backgroundSubtle": "#3b4252",
      "backgroundDeep":   "#434c5e"
    },
    "chrome": {
      "borderKind": "rounded",

      "panelBorderActive":   "primary",
      "panelBorderInactive": "foregroundMuted",
      "panelBorderFocused":  "success",
      "panelTitle":          "primary",
      "panelFooter":         "foregroundMuted",
      "panelRowSelected":     "info",
      "panelRowText":         "foreground",
      "panelTableHeader":     "info",

      "dialogBorder":         "danger",
      "dialogTitle":          "danger",
      "dialogOptionActive":   "primary",
      "dialogOptionInactive": "foregroundMuted",
      "dialogOverlay":        "background",
      "dialogOverlayOpacity": 80,

      "headerLabel":   "foregroundMuted",
      "headerValue":   "foreground",
      "headerLogo":    "info",

      "footerKey":         "foreground",
      "footerDescription": "foregroundMuted",
      "footerSeparator":   "foregroundMuted"
    },
    "surfaces": {
      "panel":       "backgroundSubtle",
      "actionBar":   "transparent",
      "messageRail": "transparent",
      "queryBar":    "transparent",
      "dialogBody":  "background",
      "header":      "transparent",
      "footer":      "transparent",
      "toast":       "transparent",
      "rowSelected": "info"
    },
    "text": {
      "info":            "primary",
      "success":         "success",
      "warning":         "warning",
      "error":           "danger",
      "dim":             "foregroundMuted",
      "helpKey":         "primary",
      "helpDescription": "foreground",
      "dialogBody":      "foreground"
    },
    "feedback": {
      "toastSuccess": "success",
      "toastError":   "danger",
      "toastInfo":    "info",
      "toastWarning": "warning",
      "safeNormal":   "foreground",
      "safeBold":     "foreground",
      "safeDim":      "foregroundMuted",
      "safeAccent":   "primary",
      "safeError":    "danger"
    },
    "data": {
      "markedBackground": "#434c5e",
      "columnForeground": "#eceff4",
      "nameForeground":   "#88c0d0"
    },
    "action": {
      "container": {
        "window":    { "background": "backgroundSubtle", "border": "primary" },
        "formInput": { "foreground": "foreground",      "background": "backgroundDeep" },
        "confirm":   { "foreground": "success",         "background": "transparent" },
        "cancel":    { "foreground": "foregroundMuted", "background": "transparent" }
      },
      "image": {
        "window":    { "background": "backgroundSubtle", "border": "primary" },
        "formInput": { "foreground": "foreground",      "background": "backgroundDeep" },
        "confirm":   { "foreground": "success",         "background": "transparent" },
        "cancel":    { "foreground": "foregroundMuted", "background": "transparent" }
      }
    }
  }
}