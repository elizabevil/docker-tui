{
  "meta": {
    "name": "Solarized",
    "description": "Solarized Rider-inspired theme"
  },
  "theme": {
    "palette": {
      "success": "#859900",
      "primary": "#2aa198",
      "info": "#268bd2",
      "danger": "#dc322f",
      "warning": "#b58900",
      "accent": "#cb4b16",
      "accentSecondary": "#6c71c4",
      "foreground": "#eee8d5",
      "foregroundMuted": "#657b83",
      "backgroundSubtle": "#002b36",
      "backgroundDeep": "#073642",
      "background": "#002030"
    },
    "border": {
      "active": {
        "token": "primary"
      },
      "inactive": {
        "token": "foregroundMuted"
      },
      "focused": {
        "token": "success"
      },
      "kind": "rounded"
    },
    "header": {
      "background": {
        "token": "transparent"
      },
      "label": {
        "token": "foregroundMuted"
      },
      "value": {
        "token": "foreground"
      },
      "logo": {
        "token": "info"
      }
    },
    "main": {
      "borderActive": {
        "token": "primary"
      },
      "borderInactive": {
        "token": "foregroundMuted"
      },
      "title": {
        "token": "primary"
      },
      "tableHeader": {
        "token": "info"
      },
      "rowSelected": {
        "token": "info"
      },
      "rowText": {
        "token": "foreground"
      },
      "footer": {
        "token": "foregroundMuted"
      },
      "actionBarBackground": {
        "token": "transparent"
      },
      "messageRailBackground": {
        "token": "transparent"
      },
      "queryBarBackground": {
        "token": "transparent"
      }
    },
    "footer": {
      "statusBackground": {
        "token": "transparent"
      },
      "shortcutBackground": {
        "token": "transparent"
      },
      "key": {
        "token": "foreground"
      },
      "description": {
        "token": "foregroundMuted"
      },
      "separator": {
        "token": "foregroundMuted"
      }
    },
    "dialog": {
      "border": {
        "token": "danger"
      },
      "title": {
        "token": "danger"
      },
      "body": {
        "token": "foreground"
      },
      "optionActive": {
        "token": "primary"
      },
      "optionInactive": {
        "token": "foregroundMuted"
      },
      "overlay": {
        "token": "background"
      },
      "overlayOpacity": 80
    },
    "toast": {
      "success": {
        "token": "success"
      },
      "error": {
        "token": "danger"
      },
      "background": {
        "token": "background"
      }
    },
    "text": {
      "info": {
        "token": "primary"
      },
      "error": {
        "token": "danger"
      },
      "success": {
        "token": "success"
      },
      "warning": {
        "token": "warning"
      },
      "dim": {
        "token": "foregroundMuted"
      },
      "helpKey": {
        "token": "primary"
      },
      "helpDescription": {
        "token": "foreground"
      }
    },
    "table": {
      "markedBackground": {
        "value": "#463f16"
      },
      "columnForeground": {
        "value": "#ECEFF1"
      },
      "nameForeground": {
        "value": "#FAF0E6"
      }
    },
    "safeFallback": {
      "normal": {
        "token": "foreground"
      },
      "bold": {
        "token": "foreground"
      },
      "dim": {
        "token": "foregroundMuted"
      },
      "accent": {
        "token": "primary"
      },
      "error": {
        "token": "danger"
      }
    }
  }
}
