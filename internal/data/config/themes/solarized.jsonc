{
  "meta": {
    "name": "Solarized",
    "description": "Solarized Rider-inspired theme"
  },
  "theme": {
    "palette": {
      "green": "#859900",
      "cyan": "#2aa198",
      "blue": "#268bd2",
      "red": "#dc322f",
      "yellow": "#b58900",
      "orange": "#cb4b16",
      "purple": "#6c71c4",
      "white": "#eee8d5",
      "gray": "#657b83",
      "dark": "#002b36",
      "surface": "#073642",
      "background": "#002030"
    },
    "border": {
      "active": { "token": "cyan" },
      "inactive": { "token": "gray" },
      "focused": { "token": "green" },
      "kind": "rounded"
    },
    "header": {
      "background": { "token": "dark" },
      "label": { "token": "gray" },
      "value": { "token": "white" },
      "logo": { "token": "blue" }
    },
    "main": {
      "borderActive": { "token": "cyan" },
      "borderInactive": { "token": "gray" },
      "title": { "token": "cyan" },
      "tableHeader": { "token": "blue" },
      "rowSelected": { "token": "blue" },
      "rowText": { "token": "white" },
      "footer": { "token": "gray" }
    },
    "footer": {
      "statusBackground": { "token": "surface" },
      "shortcutBackground": { "token": "dark" },
      "key": { "token": "white" },
      "description": { "token": "gray" },
      "separator": { "token": "gray" }
    },
    "dialog": {
      "border": { "token": "red" },
      "title": { "token": "red" },
      "body": { "token": "white" },
      "optionActive": { "token": "cyan" },
      "optionInactive": { "token": "gray" },
      "overlay": { "token": "background" },
      "overlayOpacity": 80
    },
    "toast": {
      "success": { "token": "green" },
      "error": { "token": "red" },
      "background": { "token": "dark" }
    },
    "text": {
      "info": { "token": "cyan" },
      "error": { "token": "red" },
      "success": { "token": "green" },
      "warning": { "token": "yellow" },
      "dim": { "token": "gray" },
      "helpKey": { "token": "cyan" },
      "helpDescription": { "token": "white" }
    }
  }
}
