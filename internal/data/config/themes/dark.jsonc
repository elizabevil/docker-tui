{
  "meta": {
    "name": "Dark",
    "description": "High contrast Rider-inspired dark theme"
  },
  "theme": {
    "palette": {
      "green": "#5fae6a",
      "cyan": "#4fb8c4",
      "blue": "#5fa9f7",
      "red": "#e06464",
      "yellow": "#d4ad60",
      "orange": "#d68a4a",
      "purple": "#b46fc1",
      "white": "#e6e6e6",
      "gray": "#6a7280",
      "dark": "#141517",
      "surface": "#1d1f22",
      "background": "#0e0f10"
    },
    "border": {
      "active": { "token": "cyan" },
      "inactive": { "token": "gray" },
      "focused": { "token": "green" },
      "kind": "rounded"
    },
    "header": {
      "background": { "token": "dark" },
      "label": { "token": "gray" },
      "value": { "token": "white" },
      "logo": { "token": "blue" }
    },
    "main": {
      "borderActive": { "token": "cyan" },
      "borderInactive": { "token": "gray" },
      "title": { "token": "cyan" },
      "tableHeader": { "token": "blue" },
      "rowSelected": { "token": "blue" },
      "rowText": { "token": "white" },
      "footer": { "token": "gray" }
    },
    "footer": {
      "statusBackground": { "token": "surface" },
      "shortcutBackground": { "token": "dark" },
      "key": { "token": "white" },
      "description": { "token": "gray" },
      "separator": { "token": "gray" }
    },
    "dialog": {
      "border": { "token": "red" },
      "title": { "token": "red" },
      "body": { "token": "white" },
      "optionActive": { "token": "cyan" },
      "optionInactive": { "token": "gray" },
      "overlay": { "token": "background" },
      "overlayOpacity": 80
    },
    "toast": {
      "success": { "token": "green" },
      "error": { "token": "red" },
      "background": { "token": "dark" }
    },
    "text": {
      "info": { "token": "cyan" },
      "error": { "token": "red" },
      "success": { "token": "green" },
      "warning": { "token": "yellow" },
      "dim": { "token": "gray" },
      "helpKey": { "token": "cyan" },
      "helpDescription": { "token": "white" }
    },
    "table": {
      "markedBackground": { "value": "#463f16" },
      "columnForeground": { "value": "#ECEFF1" },
      "nameForeground": { "value": "#FAF0E6" }
    },
    "safeFallback": {
      "normal": { "token": "white" },
      "bold": { "token": "white" },
      "dim": { "token": "gray" },
      "accent": { "token": "cyan" },
      "error": { "token": "red" }
    }
  }
}
