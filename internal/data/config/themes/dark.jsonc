{
  "meta": {
    "name": "Dark",
    "description": "High contrast Rider-inspired dark theme"
  },
  "theme": {
    "palette": {
      "primary": "#4fb8c4",
      "success": "#5fae6a",
      "warning": "#d4ad60",
      "danger": "#e06464",
      "info": "#5fa9f7",
      "accent": "#d68a4a",
      "accentSecondary": "#b46fc1",
      "foreground": "#e6e6e6",
      "foregroundMuted": "#6a7280",
      "background": "#0e0f10",
      "backgroundSubtle": "#141517",
      "backgroundDeep": "#1d1f22"
    },
    "chrome": {
      "borderKind": "rounded",
      "panelBorderActive": "primary",
      "panelBorderInactive": "foregroundMuted",
      "panelBorderFocused": "success",
      "panelTitle": "primary",
      "panelFooter": "foregroundMuted",
      "panelRowSelected": "info",
      "panelRowText": "foreground",
      "panelTableHeader": "info",
      "dialogBorder": "danger",
      "dialogTitle": "danger",
      "dialogOptionActive": "primary",
      "dialogOptionInactive": "foregroundMuted",
      "dialogOverlay": "background",
      "dialogOverlayOpacity": 80,
      "headerLabel": "foregroundMuted",
      "headerValue": "foreground",
      "headerLogo": "info",
      "footerKey": "foreground",
      "footerDescription": "foregroundMuted",
      "footerSeparator": "foregroundMuted"
    },
    "surfaces": {
      "panel": "transparent",
      "actionBar": "transparent",
      "messageRail": "transparent",
      "queryBar": "transparent",
      "dialogBody": "#1a1b1c",
      "header": "transparent",
      "footer": "transparent",
      "toast": "transparent",
      "rowSelected": "info"
    },
    "text": {
      "info": "primary",
      "success": "success",
      "warning": "warning",
      "error": "danger",
      "dim": "foregroundMuted",
      "helpKey": "primary",
      "helpDescription": "foreground",
      "dialogBody": "foreground"
    },
    "feedback": {
      "toastSuccess": "success",
      "toastError": "danger",
      "toastInfo": "info",
      "toastWarning": "warning",
      "safeNormal": "foreground",
      "safeBold": "foreground",
      "safeDim": "foregroundMuted",
      "safeAccent": "primary",
      "safeError": "danger"
    },
    "data": {
      "markedBackground": "#463f16",
      "columnForeground": "#ECEFF1",
      "nameForeground": "#FAF0E6"
    },
    "action": {
      "container": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      },
      "image": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      },
      "volume": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      },
      "network": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      },
      "compose": {
        "window": {
          "background": "backgroundSubtle",
          "border": "primary"
        },
        "formInput": {
          "foreground": "foreground",
          "background": "backgroundDeep"
        },
        "confirm": {
          "foreground": "success",
          "background": "transparent"
        },
        "cancel": {
          "foreground": "foregroundMuted",
          "background": "transparent"
        }
      }
    }
  }
}
