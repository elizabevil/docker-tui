{
  // Default configuration — embedded at build time.
  // Users can override any field in ~/.config/docker-tui/config.yml
  "configVersion": 1,
  "general": {
    "scrollHeight": 2,
    "reporting": "off",
    "lang": "en",
    "sizeFormat": "binary"
    // "binary" = 1024-base (MiB/GiB), "si" = 1000-base (MB/GB, matches podman/docker CLI)
  },
  "ui": {
    "wrapMainPanel": false,
    "returnImmediately": false,
    "borderStyle": "rounded",
    "showHelp": true,
    "hintTimeout": 3,
    "dialogOverlayColor": "#0d1117cc"
  },
  "docker": {
    "timeout": 30000000000,
    "statsPollSec": 3
    // 30s in nanoseconds (time.Duration)
  },
  "runtime": {
    "default": "local-docker",
    "discovery": {
      "localDocker": true,
      "localPodman": true
    },
    "health": {
      "intervalSec": 3,
      "timeoutSec": 2,
      "failureThreshold": 2
    },
    "connections": [
      // Example remote connection:
      // {
      //   "name": "remote-docker",
      //   "driver": "docker",
      //   "endpoint": "tcp://docker.example.com:2376",
      //   "apiVersion": "",
      //   "tls": {
      //     "enabled": true,
      //     "verify": true,
      //     "insecureSkipVerify": false,
      //     "caFile": "/etc/docker/certs/ca.pem",
      //     "certFile": "/etc/docker/certs/cert.pem",
      //     "keyFile": "/etc/docker/certs/key.pem",
      //     "serverName": "docker.example.com"
      //   }
      // }
    ]
  },
  "logs": {
    "since": "1h",
    "tail": "200",
    "timestamps": false
  },
  "layout": {
    "sectionWeights": {
      "top": 2,
      "content": 7,
      "bottom": 1
    },
    "background": {
      "enable": false,
      "type": "image",
      "color": "red"
    }
  },
  "commandTemplates": {
    "dockerCompose": "docker compose"
  },
  "keymap": {
    "quit": [
      "q",
      "ctrl+c"
    ],
    "help": [
      "?",
      "f1"
    ],
    "filter": [
      "/"
    ],
    "refresh": [
      "r"
    ],
    "containerStart": [
      "s"
    ],
    "containerStop": [
      "ctrl+s"
    ],
    "containerRestart": [
      "ctrl+r"
    ],
    "containerKill": [
      "ctrl+k"
    ],
    "containerRemove": [
      "ctrl+d"
    ],
    "containerLogs": [
      "l"
    ],
    "containerExec": [
      "e"
    ],
    "containerInspect": [
      "i"
    ],
    "containerStats": [
      "m"
    ],
    "containerPause": [
      "p"
    ],
    // TASK-019: advanced container actions.
    "containerUpdate": [
      "ctrl+w"
    ],
    "containerDiff": [
      "f2"
    ],
    "containerExport": [
      "ctrl+x"
    ],
    "containerCommit": [
      "ctrl+k"
    ],
    "containerWait": [
      "ctrl+y"
    ],
    "containerCopy": [
      "ctrl+o"
    ],
    "imagePull": [
      "ctrl+p"
    ],
    "imageRemove": [
      "ctrl+d"
    ],
    "imagePrune": [
      "p"
    ],
    "imageTag": [
      "ctrl+t"
    ],
    "imagePush": [
      "ctrl+u"
    ],
    "imageSave": [
      "ctrl+e"
    ],
    "imageLoad": [
      "ctrl+l"
    ],
    "volumeCreate": [
      "c"
    ],
    "volumePrune": [
      "p"
    ],
    "volumeRemove": [
      "ctrl+d"
    ],
    "networkCreate": [
      "c"
    ],
    "networkPrune": [
      "p"
    ],
    "networkRemove": [
      "ctrl+d"
    ],
    "tabNext": [
      "tab"
    ],
    "tabPrev": [
      "shift+tab"
    ],
    "up": [
      "up",
      "k"
    ],
    "down": [
      "down",
      "j"
    ],
    "enter": [
      "enter"
    ],
    "back": [
      "esc"
    ],
    "delete": [
      "ctrl+d"
    ]
  }
}
